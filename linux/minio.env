# MinIO Environment Variables
# Source this file in /etc/default/minio

MINIO_ROOT_USER=${MINIO_ROOT_USER:-minioadmin}
MINIO_ROOT_PASSWORD=${MINIO_ROOT_PASSWORD:-minioadmin}
MINIO_SERVER_URL=${MINIO_SERVER_URL:-https://s3.v2.selys.app}
MINIO_BROWSER_REDIRECT_URL=${MINIO_BROWSER_REDIRECT_URL:-https://minio.v2.selys.app}
